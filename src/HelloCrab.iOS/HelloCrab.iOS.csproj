<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios26.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <ApplicationTitle>HelloCrab Remote</ApplicationTitle>
    <ApplicationId>com.hellocrab.remote</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <!-- GitHub Actions always creates an unsigned Simulator package. -->
    <CodesignConfigureDependsOn>$(CodesignConfigureDependsOn);DisableCodesignInSimulator</CodesignConfigureDependsOn>
  </PropertyGroup>

  <Target Name="DisableCodesignInSimulator" Condition="'$(SdkIsSimulator)' == 'true'">
    <PropertyGroup>
      <EnableCodeSigning>false</EnableCodeSigning>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <ImageAsset Include="Assets.xcassets\**\*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HelloCrab.Core\HelloCrab.Core.csproj" />
    <PackageReference Include="Avalonia.iOS" Version="12.1.0" />
  </ItemGroup>
</Project>
